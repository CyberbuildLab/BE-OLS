#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/bcore#describes
<https://w3id.org/bcore#describes> rdf:type owl:ObjectProperty ;
                                   rdfs:domain <https://w3id.org/bcore#MediaFile> ;
                                   rdfs:range [ rdf:type owl:Class ;
                                                owl:unionOf ( <https://w3id.org/brot#Bridge>
                                                              <https://w3id.org/brot#Component>
                                                            )
                                              ] ;
                                   rdfs:comment "Mediendatei beschreibt (stellt dar, zeigt, veranschaulicht) eine Brücke oder ein Bauteil"@de ,
                                                "media file describes (represents, depicts, illustrates) a bridge or a bridge component"@en ;
                                   rdfs:label "beschreibt"@de ,
                                              "describes"@en .


###  https://w3id.org/bcore/media#containsMedia
:containsMedia rdf:type owl:ObjectProperty ,
                        owl:AsymmetricProperty ,
                        owl:TransitiveProperty ;
               rdfs:domain <https://w3id.org/bcore#MediaFile> ;
               rdfs:range <https://w3id.org/bcore#MediaFile> ;
               rdfs:comment "Mediendatei enthält eine andere Mediendatei"@de ,
                            "media file contains another media file"@en ;
               rdfs:label "contains media"@en ,
                          "enthält Mediendatei"@de .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/bcore/media#ImageResolutionX
:ImageResolutionX rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :Image ;
                  rdfs:range xsd:integer ;
                  rdfs:comment "Bildauflösung in X-Richtung"@de ,
                               "image resolution in X-direction"@en ;
                  rdfs:label "Bildauflösung X"@de ,
                             "image resolution X"@en ;
                  <https://schema.org/unitText> "pixel" .


###  https://w3id.org/bcore/media#ImageResolutionY
:ImageResolutionY rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :Image ;
                  rdfs:range xsd:integer ;
                  rdfs:comment "Bildauflösung in Y-Richtung"@de ,
                               "image resolution in Y-direction"@en ;
                  rdfs:label "Bildauflösung Y"@de ,
                             "image resolution Y"@en ;
                  <https://schema.org/unitText> "pixel" .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/bcore#MediaFile
<https://w3id.org/bcore#MediaFile> rdf:type owl:Class .


###  https://w3id.org/bcore/media#Document
:Document rdf:type owl:Class ;
          rdfs:subClassOf <https://w3id.org/bcore#MediaFile> ;
          rdfs:comment "Physische oder digitale Darstellung einer Informationseinheit, die zur Kommunikation verwendet werden kann"@de ,
                       "physical or digital representation of a body of information designed with the capacity to communicate"@en ;
          rdfs:label "Dokument"@de ,
                     "document"@en ;
          rdfs:seeAlso "http://semanticscience.org/resource/SIO_000148" .


###  https://w3id.org/bcore/media#Image
:Image rdf:type owl:Class ;
       rdfs:subClassOf <https://w3id.org/bcore#MediaFile> ;
       rdfs:comment "Bilddatei"@de ,
                    "image file"@en ;
       rdfs:label "Bild"@de ,
                  "image"@en ;
       rdfs:seeAlso "http://semanticscience.org/resource/SIO_000081" .


###  https://w3id.org/bcore/media#Photo
:Photo rdf:type owl:Class ;
       rdfs:subClassOf :Image ;
       rdfs:comment "Foto (entstanden durch auf eine lichtempfindliche Oberfläche fallendes Licht)"@de ,
                    "photograph (created by light falling on light-sensitive surface)"@en ;
       rdfs:label "Foto"@de ,
                  "photo"@en ;
       rdfs:seeAlso "http://semanticscience.org/resource/SIO_000082" .


###  https://w3id.org/brot#Bridge
<https://w3id.org/brot#Bridge> rdf:type owl:Class .


