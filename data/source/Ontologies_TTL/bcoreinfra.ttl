xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/bcore/infra#FootCycleRouteType
:FootCycleRouteType rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :FootCycleRoute ;
                    rdfs:range [ rdf:type rdfs:Datatype ;
                                 owl:oneOf [ rdf:type rdf:List ;
                                             rdf:first "bike only" ;
                                             rdf:rest [ rdf:type rdf:List ;
                                                        rdf:first "foot only" ;
                                                        rdf:rest [ rdf:type rdf:List ;
                                                                   rdf:first "segregated" ;
                                                                   rdf:rest [ rdf:type rdf:List ;
                                                                              rdf:first "shared-use" ;
                                                                              rdf:rest rdf:nil
                                                                            ]
                                                                 ]
                                                      ]
                                           ]
                               ] ;
                    rdfs:comment "Art des Fuß- und/oder Radweges"@de ,
                                 """Type of pedestrian and/or bike path. Possible values:
- foot only
- bike only
- segregated
- shared-use"""@en ;
                    rdfs:label "Fuß- oder Gehwegtyp"@de ,
                               "foot or cycle route type"@en .


###  https://w3id.org/bcore/infra#RailwayRouteMaximumVelocity
:RailwayRouteMaximumVelocity rdf:type owl:DatatypeProperty ,
                                      owl:FunctionalProperty ;
                             rdfs:domain :RailwayRoute ;
                             rdfs:range xsd:decimal ;
                             rdfs:comment "maximal zulässige Geschwindigkeit auf dem Schienenweg"@de ,
                                          "maximum permitted speed on the rail line"@en ;
                             rdfs:label "Eisenbahntrasse maximale Geschwindigkeit"@de ,
                                        "railway route maximum velocity"@en ;
                             <https://schema.org/unitText> "km/h" .


###  https://w3id.org/bcore/infra#RailwayRouteNumberOfTracks
:RailwayRouteNumberOfTracks rdf:type owl:DatatypeProperty ,
                                     owl:FunctionalProperty ;
                            rdfs:domain :RailwayRoute ;
                            rdfs:range xsd:integer ;
                            rdfs:comment "Anzahl der Gleise des Schienenweges"@de ,
                                         "number of tracks on the railroad"@en ;
                            rdfs:label "Eisenbahntrasse Gleisanzahl"@de ,
                                       "railway route number of tracks"@en ;
                            <https://schema.org/unitText> "-" .


###  https://w3id.org/bcore/infra#RoadRouteClass
:RoadRouteClass rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :RoadRoute ;
                rdfs:range [ rdf:type rdfs:Datatype ;
                             owl:oneOf [ rdf:type rdf:List ;
                                         rdf:first "agricultural road" ;
                                         rdf:rest [ rdf:type rdf:List ;
                                                    rdf:first "country road" ;
                                                    rdf:rest [ rdf:type rdf:List ;
                                                               rdf:first "district road" ;
                                                               rdf:rest [ rdf:type rdf:List ;
                                                                          rdf:first "federal road" ;
                                                                          rdf:rest [ rdf:type rdf:List ;
                                                                                     rdf:first "highway" ;
                                                                                     rdf:rest [ rdf:type rdf:List ;
                                                                                                rdf:first "non-public road" ;
                                                                                                rdf:rest [ rdf:type rdf:List ;
                                                                                                           rdf:first "urban road" ;
                                                                                                           rdf:rest rdf:nil
                                                                                                         ]
                                                                                              ]
                                                                                   ]
                                                                        ]
                                                             ]
                                                  ]
                                       ]
                           ] ;
                rdfs:comment "Klassifizierung der Straße"@de ,
                             """Road classification. Possible values:
- highway
- federal road
- country road
- district road
- urban road
- agricultural road
- non-public road"""@en ;
                rdfs:label "Straßentrasse Klasse"@de ,
                           "road route class"@en .


###  https://w3id.org/bcore/infra#RoadRouteNumberOfLanes
:RoadRouteNumberOfLanes rdf:type owl:DatatypeProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain :RoadRoute ;
                        rdfs:range xsd:integer ;
                        rdfs:comment "Anzahl der Fahrstreifen der Straße (Gesamtzahl beider Richtungsfahrbahnen)"@de ,
                                     "number of lanes on the road (total number of lanes in both directions)"@en ;
                        rdfs:label "Straßentrasse Spurenanzahl"@de ,
                                   "road route number of lanes"@en ;
                        <https://schema.org/unitText> "-" .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/bcore#InfrastructureRoute
<https://w3id.org/bcore#InfrastructureRoute> rdf:type owl:Class .


###  https://w3id.org/bcore/infra#FootCycleRoute
:FootCycleRoute rdf:type owl:Class ;
                rdfs:subClassOf <https://w3id.org/bcore#InfrastructureRoute> ;
                rdfs:comment "Trasse eines Geh- und/oder Radweges"@de ,
                             "route of a footpath and/or bike path"@en ;
                rdfs:label "Fuß- oder Radwegtrasse"@de ,
                           "foot or cycle route"@en .


###  https://w3id.org/bcore/infra#RailwayRoute
:RailwayRoute rdf:type owl:Class ;
              rdfs:subClassOf <https://w3id.org/bcore#InfrastructureRoute> ;
              rdfs:comment "Trasse eines Schienenweges"@de ,
                           "railway line, railroad"@en ;
              rdfs:label "Eisenbahntrasse"@de ,
                         "railway route"@en .


###  https://w3id.org/bcore/infra#RoadRoute
:RoadRoute rdf:type owl:Class ;
           rdfs:subClassOf <https://w3id.org/bcore#InfrastructureRoute> ;
           rdfs:comment "Trasse einer Straße/ eines Feldweges/ einer Autobahn"@de ,
                        "route of a street/road/highway/federal way/..."@en ;
           rdfs:label "Straßentrasse"@de ,
                      "road route" .


###  https://w3id.org/bcore/infra#WaterWayRoute
:WaterWayRoute rdf:type owl:Class ;
               rdfs:subClassOf <https://w3id.org/bcore#InfrastructureRoute> ;
               rdfs:comment "Trasse einer Wasserstraße"@de ,
                            "route of a water way"@en ;
               rdfs:label "Wasserstraßentrasse"@de ,
                          "water way route"@en .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :FootCycleRoute
                :RailwayRoute
                :RoadRoute
                :WaterWayRoute
              )
] .


