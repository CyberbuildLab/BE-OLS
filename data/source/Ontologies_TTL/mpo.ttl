@prefix : <http://www.theworldavatar.com/kg/ontomatpassport/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ontomatpassport: <http://www.theworldavatar.com/kg/ontomatpassport/> .
@base <http://www.theworldavatar.com/kg/ontomatpassport/> .

<http://www.theworldavatar.com/kg/ontomatpassport/> rdf:type owl:Ontology ;
                                                     dc:date "23 September 2025" ;
                                                     ontomatpassport:gitCommitHash "c0599beca8df55873a1ab061dee64e52c510c6a0" ;
                                                     rdfs:comment "The Material Passport Ontology (MPO) is an ontology developed for representing material passports of products and components. It is also known as OntoMatPassport." ;
                                                     owl:versionInfo "1.0.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/date
dc:date rdf:type owl:AnnotationProperty .


###  http://www.theworldavatar.com/kg/ontomatpassport/gitCommitHash
ontomatpassport:gitCommitHash rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:ObjectProperty ;
           owl:equivalentProperty <http://www.wikidata.org/prop/direct/P170> ;
           rdfs:domain ontomatpassport:MaterialPassport ;
           rdfs:range ontomatpassport:Manufacturer ;
           rdfs:comment "The organisation responsible for creating the material passport." ;
           rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
           rdfs:label "creator" .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/hasUnit
<http://www.ontology-of-units-of-measure.org/resource/om-2/hasUnit> rdf:type owl:ObjectProperty ;
                                                                    rdfs:domain <http://www.ontology-of-units-of-measure.org/resource/om-2/Measure> ;
                                                                    rdfs:range <http://www.ontology-of-units-of-measure.org/resource/om-2/Unit> ;
                                                                    rdfs:comment "An object property referring to the unit associated with a measured value." ;
                                                                    rdfs:isDefinedBy <http://www.ontology-of-units-of-measure.org/resource/om-2> ;
                                                                    rdfs:label "hasUnit" .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/hasValue
<http://www.ontology-of-units-of-measure.org/resource/om-2/hasValue> rdf:type owl:ObjectProperty ;
                                                                     rdfs:domain <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
                                                                     rdfs:range <http://www.ontology-of-units-of-measure.org/resource/om-2/Measure> ;
                                                                     rdfs:comment "An object property referring to the measured value of a quantity." ;
                                                                     rdfs:isDefinedBy <http://www.ontology-of-units-of-measure.org/resource/om-2> ;
                                                                     rdfs:label "hasValue" .


###  http://www.theworldavatar.com/kg/ontomatpassport/describes
ontomatpassport:describes rdf:type owl:ObjectProperty ;
                          rdfs:domain ontomatpassport:MaterialPassport ;
                          rdfs:range [ rdf:type owl:Class ;
                                       owl:unionOf ( <http://emmo.info/emmo#EMMO_4207e895_8b83_4318_996a_72cfb32acd94>
                                                     ontomatpassport:Component
                                                     ontomatpassport:Product
                                                   )
                                     ] ;
                          rdfs:comment "An object property indicating what is described by a material passport." ;
                          rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                          rdfs:label "describes" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasChemicalComposition
ontomatpassport:hasChemicalComposition rdf:type owl:ObjectProperty ;
                                       rdfs:domain <http://emmo.info/emmo#EMMO_4207e895_8b83_4318_996a_72cfb32acd94> ;
                                       rdfs:range ontomatpassport:ChemicalComposition ;
                                       rdfs:comment "An object property referring to the chemical composition of a material." ;
                                       rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                                       rdfs:label "hasChemicalComposition" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasCollector
ontomatpassport:hasCollector rdf:type owl:ObjectProperty ;
                             rdfs:domain [ rdf:type owl:Class ;
                                           owl:unionOf ( <http://emmo.info/emmo#EMMO_4207e895_8b83_4318_996a_72cfb32acd94>
                                                         ontomatpassport:Component
                                                         ontomatpassport:Product
                                                       )
                                         ] ;
                             rdfs:range ontomatpassport:Collector ;
                             rdfs:comment "An object property referring to the collector of a component, product or material." ;
                             rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                             rdfs:label "hasCollector" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasCountry
ontomatpassport:hasCountry rdf:type owl:ObjectProperty ;
                           owl:equivalentProperty <http://www.wikidata.org/prop/direct/P17> ;
                           rdfs:domain [ rdf:type owl:Class ;
                                         owl:unionOf ( ontomatpassport:Manufacturer
                                                       ontomatpassport:Supplier
                                                     )
                                       ] ;
                           rdfs:range <https://dbpedia.org/ontology/Country> ;
                           rdfs:comment "An object property referring to the country where a manufacturing company is located." ;
                           rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                           rdfs:label "hasCountry" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasImage
ontomatpassport:hasImage rdf:type owl:ObjectProperty ;
                         owl:equivalentProperty <http://www.wikidata.org/prop/direct/P18> ;
                         rdfs:domain [ rdf:type owl:Class ;
                                       owl:unionOf ( ontomatpassport:Component
                                                     ontomatpassport:Product
                                                   )
                                     ] ;
                         rdfs:range <http://purl.org/dc/dcmitype/Image> ;
                         rdfs:comment "An object property referring to the image of a product or component." ;
                         rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                         rdfs:label "hasImage" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasManufacturer
ontomatpassport:hasManufacturer rdf:type owl:ObjectProperty ;
                                owl:equivalentProperty <http://www.wikidata.org/prop/direct/P176> ;
                                rdfs:domain [ rdf:type owl:Class ;
                                              owl:unionOf ( <http://emmo.info/emmo#EMMO_4207e895_8b83_4318_996a_72cfb32acd94>
                                                            ontomatpassport:Component
                                                            ontomatpassport:Product
                                                          )
                                            ] ;
                                rdfs:range ontomatpassport:Manufacturer ;
                                rdfs:comment "An object property referring to the manufacturer of a component, product or material." ;
                                rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                                rdfs:label "hasManufacturer" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasMaterial
ontomatpassport:hasMaterial rdf:type owl:ObjectProperty ;
                            owl:equivalentProperty <http://www.wikidata.org/prop/direct/P186> ;
                            rdfs:domain [ rdf:type owl:Class ;
                                          owl:unionOf ( ontomatpassport:Component
                                                        ontomatpassport:Product
                                                      )
                                        ] ;
                            rdfs:range <http://emmo.info/emmo#EMMO_4207e895_8b83_4318_996a_72cfb32acd94> ;
                            rdfs:comment "An object property referring to the material of a component or product." ;
                            rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                            rdfs:label "hasMaterial" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasProperty
ontomatpassport:hasProperty rdf:type owl:ObjectProperty ;
                            rdfs:domain [ rdf:type owl:Class ;
                                          owl:unionOf ( <http://emmo.info/emmo#EMMO_4207e895_8b83_4318_996a_72cfb32acd94>
                                                        ontomatpassport:Component
                                                        ontomatpassport:Product
                                                      )
                                        ] ;
                            rdfs:range <http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#Property> ;
                            rdfs:comment "An object property referring to a property or characteristic of a component, product or material." ;
                            rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                            rdfs:label "hasProperty" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasRecycler
ontomatpassport:hasRecycler rdf:type owl:ObjectProperty ;
                            rdfs:domain [ rdf:type owl:Class ;
                                          owl:unionOf ( <http://emmo.info/emmo#EMMO_4207e895_8b83_4318_996a_72cfb32acd94>
                                                        ontomatpassport:Component
                                                        ontomatpassport:Product
                                                      )
                                        ] ;
                            rdfs:range ontomatpassport:Recycler ;
                            rdfs:comment "An object property referring to the recycler of a component, product or material." ;
                            rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                            rdfs:label "hasRecycler" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasRegistrationCountry
ontomatpassport:hasRegistrationCountry rdf:type owl:ObjectProperty ;
                                       rdfs:subPropertyOf ontomatpassport:hasCountry ;
                                       rdfs:domain [ rdf:type owl:Class ;
                                                     owl:unionOf ( ontomatpassport:Manufacturer
                                                                   ontomatpassport:Supplier
                                                                 )
                                                   ] ;
                                       rdfs:range <https://dbpedia.org/ontology/Country> ;
                                       rdfs:comment "An object property referring to the country where a manufacturer, supplier, company or industry is registered." ;
                                       rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                                       rdfs:label "hasRegistrationCountry" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasSpecificHeatCapacity
ontomatpassport:hasSpecificHeatCapacity rdf:type owl:ObjectProperty ;
                                        rdfs:domain <http://emmo.info/emmo#EMMO_4207e895_8b83_4318_996a_72cfb32acd94> ;
                                        rdfs:range <http://www.ontology-of-units-of-measure.org/resource/om-2/SpecificHeatCapacity> ;
                                        rdfs:comment "The quantity of heat needed to increase the temperature of a material's unit mass by one unit." ;
                                        rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                                        rdfs:label "hasSpecificHeatCapacity" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasSupplier
ontomatpassport:hasSupplier rdf:type owl:ObjectProperty ;
                            rdfs:domain [ rdf:type owl:Class ;
                                          owl:unionOf ( <http://emmo.info/emmo#EMMO_4207e895_8b83_4318_996a_72cfb32acd94>
                                                        ontomatpassport:Component
                                                        ontomatpassport:Product
                                                      )
                                        ] ;
                            rdfs:range ontomatpassport:Supplier ;
                            rdfs:comment "An object property referring to the supplier of a component, product or material." ;
                            rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                            rdfs:label "hasSupplier" .


###  http://www.wikidata.org/prop/direct/P17
<http://www.wikidata.org/prop/direct/P17> rdf:type owl:ObjectProperty .


###  http://www.wikidata.org/prop/direct/P170
<http://www.wikidata.org/prop/direct/P170> rdf:type owl:ObjectProperty .


###  http://www.wikidata.org/prop/direct/P176
<http://www.wikidata.org/prop/direct/P176> rdf:type owl:ObjectProperty .


###  http://www.wikidata.org/prop/direct/P18
<http://www.wikidata.org/prop/direct/P18> rdf:type owl:ObjectProperty .


###  http://www.wikidata.org/prop/direct/P186
<http://www.wikidata.org/prop/direct/P186> rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/dc/terms/URI
<http://purl.org/dc/terms/URI> rdf:type owl:DatatypeProperty ;
                               rdfs:domain <http://purl.org/dc/dcmitype/Image> ;
                               rdfs:range xsd:anyURI ;
                               rdfs:comment "The locatable address of an image on the web." ;
                               rdfs:isDefinedBy <http://purl.org/dc/terms/URI> ;
                               rdfs:label "URI" .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain ontomatpassport:MaterialPassport ;
                                   rdfs:range xsd:dateTime ;
                                   rdfs:comment "The date and time when the material passport was created." ;
                                   rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                                   rdfs:label "created" .


###  http://purl.org/goodrelations/v1#name
<http://purl.org/goodrelations/v1#name> rdf:type owl:DatatypeProperty ;
                                        owl:equivalentProperty <http://www.wikidata.org/prop/direct/P2561> ;
                                        rdfs:domain [ rdf:type owl:Class ;
                                                      owl:unionOf ( ontomatpassport:Component
                                                                    ontomatpassport:ConstituentMaterial
                                                                    ontomatpassport:ConstituentPart
                                                                    ontomatpassport:Manufacturer
                                                                    ontomatpassport:MaterialPassport
                                                                    ontomatpassport:Product
                                                                    ontomatpassport:Supplier
                                                                  )
                                                    ] ;
                                        rdfs:range xsd:string ;
                                        rdfs:comment "A linguistic identity of a product, component, material, or any other entity." ;
                                        rdfs:isDefinedBy <http://purl.org/goodrelations/v1> ;
                                        rdfs:label "name" .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/hasNumericalValue
<http://www.ontology-of-units-of-measure.org/resource/om-2/hasNumericalValue> rdf:type owl:DatatypeProperty ;
                                                                              owl:equivalentProperty <http://www.wikidata.org/prop/direct/P1181> ;
                                                                              rdfs:domain <http://www.ontology-of-units-of-measure.org/resource/om-2/Measure> ;
                                                                              rdfs:range xsd:float ;
                                                                              rdfs:comment "The numerical value of a measured quantity." ;
                                                                              rdfs:isDefinedBy <http://www.ontology-of-units-of-measure.org/resource/om-2> ;
                                                                              rdfs:label "hasNumericalValue" .


###  http://www.theworldavatar.com/kg/ontomatpassport/description
ontomatpassport:description rdf:type owl:DatatypeProperty ;
                            rdfs:domain [ rdf:type owl:Class ;
                                          owl:unionOf ( <http://emmo.info/emmo#EMMO_4207e895_8b83_4318_996a_72cfb32acd94>
                                                        ontomatpassport:Component
                                                        ontomatpassport:Product
                                                      )
                                        ] ;
                            rdfs:range xsd:string ;
                            rdfs:comment "A narrative or detailed account of a product, component or material." ;
                            rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                            rdfs:label "description" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasAutomaticTrackingOrScanning
ontomatpassport:hasAutomaticTrackingOrScanning rdf:type owl:DatatypeProperty ;
                                               rdfs:domain [ rdf:type owl:Class ;
                                                             owl:unionOf ( ontomatpassport:Component
                                                                           ontomatpassport:Product
                                                                         )
                                                           ] ;
                                               rdfs:range xsd:boolean ;
                                               rdfs:comment "A datatype property that indicates if a product or component has an automatic tracking number in the form of a barcode or any other means." ;
                                               rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                                               rdfs:label "hasAutomaticTrackingOrScanning" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasBrandName
ontomatpassport:hasBrandName rdf:type owl:DatatypeProperty ;
                             rdfs:subPropertyOf <http://purl.org/goodrelations/v1#name> ;
                             rdfs:domain [ rdf:type owl:Class ;
                                           owl:unionOf ( ontomatpassport:Component
                                                         ontomatpassport:Product
                                                       )
                                         ] ;
                             rdfs:range xsd:string ;
                             rdfs:comment "A name that indicates the commercial brand of a product or component." ;
                             rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                             rdfs:label "hasBrandName" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasEAN
ontomatpassport:hasEAN rdf:type owl:DatatypeProperty ;
                       rdfs:domain [ rdf:type owl:Class ;
                                     owl:unionOf ( ontomatpassport:Component
                                                   ontomatpassport:Product
                                                 )
                                   ] ;
                       rdfs:range xsd:string ;
                       rdfs:comment "A datatype property expressing the European Article Number (EAN) of a product or component." ;
                       rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                       rdfs:label "hasEAN" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasFeedstockFractionFromRecycledProduct
ontomatpassport:hasFeedstockFractionFromRecycledProduct rdf:type owl:DatatypeProperty ;
                                                        rdfs:domain [ rdf:type owl:Class ;
                                                                      owl:unionOf ( ontomatpassport:Component
                                                                                    ontomatpassport:ConstituentMaterial
                                                                                    ontomatpassport:ConstituentPart
                                                                                    ontomatpassport:Product
                                                                                  )
                                                                    ] ;
                                                        rdfs:range xsd:float ;
                                                        rdfs:comment "A datatype property indicating the fraction of feedstock produced from recycled products or components." ;
                                                        rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                                                        rdfs:label "hasFeedstockFractionFromRecycledProduct" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasFeedstockFractionFromReusedProduct
ontomatpassport:hasFeedstockFractionFromReusedProduct rdf:type owl:DatatypeProperty ;
                                                      rdfs:domain [ rdf:type owl:Class ;
                                                                    owl:unionOf ( ontomatpassport:Component
                                                                                  ontomatpassport:ConstituentMaterial
                                                                                  ontomatpassport:ConstituentPart
                                                                                  ontomatpassport:Product
                                                                                )
                                                                  ] ;
                                                      rdfs:range xsd:float ;
                                                      rdfs:comment "A datatype property indicating the fraction of feedstock produced from reused sources." ;
                                                      rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                                                      rdfs:label "hasFeedstockFractionFromReusedProduct" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasFunctionalUnit
ontomatpassport:hasFunctionalUnit rdf:type owl:DatatypeProperty ;
                                  rdfs:domain ontomatpassport:EnvironmentalProperty ;
                                  rdfs:range xsd:string ;
                                  rdfs:comment "A property that specifies the reference quantity or unit of measurement for which the environmental impact of a product is assessed, e.g., 1 kilogram of product." ;
                                  rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                                  rdfs:label "hasFunctionalUnit" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasFunctionality
ontomatpassport:hasFunctionality rdf:type owl:DatatypeProperty ;
                                 rdfs:domain [ rdf:type owl:Class ;
                                               owl:unionOf ( ontomatpassport:Component
                                                             ontomatpassport:Product
                                                           )
                                             ] ;
                                 rdfs:range xsd:string ;
                                 rdfs:comment "The intended purpose of a product or component." ;
                                 rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                                 rdfs:label "hasFunctionality" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasGTIN
ontomatpassport:hasGTIN rdf:type owl:DatatypeProperty ;
                        owl:equivalentProperty <http://www.wikidata.org/prop/direct/P3962> ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( ontomatpassport:Component
                                                    ontomatpassport:Product
                                                  )
                                    ] ;
                        rdfs:range xsd:string ;
                        rdfs:comment "A datatype property expressing the Global Trade Item Number (GTIN) of a product or component." ;
                        rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                        rdfs:label "hasGTIN" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasHazardSummaryDocument
ontomatpassport:hasHazardSummaryDocument rdf:type owl:DatatypeProperty ;
                                         rdfs:domain [ rdf:type owl:Class ;
                                                       owl:unionOf ( ontomatpassport:Component
                                                                     ontomatpassport:ConstituentMaterial
                                                                     ontomatpassport:ConstituentPart
                                                                     ontomatpassport:Product
                                                                   )
                                                     ] ;
                                         rdfs:range xsd:anyURI ;
                                         rdfs:comment "A document providing an overview of potential risks and hazards associated with the use, handling, storage, transportation, and disposal of a product or component." ;
                                         rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                                         rdfs:label "hasHazardSummaryDocument" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasIndexValue
ontomatpassport:hasIndexValue rdf:type owl:DatatypeProperty ;
                              rdfs:subPropertyOf <http://www.ontology-of-units-of-measure.org/resource/om-2/hasNumericalValue> ;
                              rdfs:domain [ rdf:type owl:Class ;
                                            owl:unionOf ( ontomatpassport:LinearFlowIndex
                                                          ontomatpassport:MaterialCircularityIndicator
                                                        )
                                          ] ;
                              rdfs:range xsd:float ;
                              rdfs:comment "The measured/assessed quantity expressed as a value between 0 and 1 inclusive." ;
                              rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                              rdfs:label "hasIndexValue" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasLFI
ontomatpassport:hasLFI rdf:type owl:DatatypeProperty ;
                       rdfs:domain [ rdf:type owl:Class ;
                                     owl:unionOf ( ontomatpassport:Component
                                                   ontomatpassport:ConstituentMaterial
                                                   ontomatpassport:ConstituentPart
                                                   ontomatpassport:Product
                                                 )
                                   ] ;
                       rdfs:range xsd:float ;
                       rdfs:comment "A datatype property indicating the measure of how linear the materials of a product are." ;
                       rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                       rdfs:label "hasLFI" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasMCI
ontomatpassport:hasMCI rdf:type owl:DatatypeProperty ;
                       rdfs:domain [ rdf:type owl:Class ;
                                     owl:unionOf ( ontomatpassport:Component
                                                   ontomatpassport:ConstituentMaterial
                                                   ontomatpassport:ConstituentPart
                                                   ontomatpassport:Product
                                                 )
                                   ] ;
                       rdfs:range xsd:float ;
                       rdfs:comment "A datatype property indicating the measure of how circular the materials of a product are." ;
                       rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                       rdfs:label "hasMCI" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasMass
ontomatpassport:hasMass rdf:type owl:DatatypeProperty ;
                        owl:equivalentProperty <http://www.wikidata.org/prop/direct/P2067> ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( ontomatpassport:Component
                                                    ontomatpassport:ConstituentMaterial
                                                    ontomatpassport:ConstituentPart
                                                    ontomatpassport:Product
                                                  )
                                    ] ;
                        rdfs:range xsd:float ;
                        rdfs:comment "A datatype property indicating the mass of a product or component." ;
                        rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                        rdfs:label "hasMass" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasNumber
ontomatpassport:hasNumber rdf:type owl:DatatypeProperty ;
                          rdfs:range xsd:string ;
                          rdfs:comment "A string of numerals that expresses the identity of an object." ;
                          rdfs:isDefinedBy <http://www.theworldavatar.com/kg/ontomatpassport> ;
                          rdfs:label "hasNumber" .


###  http://www.theworldavatar.com/kg/ontomatpassport/hasPercentageValue
ontomatpassport:hasPercentageValue rdf:type owl:DatatypeProperty ;
                                   rdfs:subPropertyOf <http://www.ontology-of-units-of-measure.org/resource/om-2/hasNumericalValue> ;
                                   rdfs:domain [ rdf:type owl:Class ;
                                                 owl:unionOf ( ontomatpassport:FeedstockFractionFromRecycledProduct
                                                               ontomatpassport:FeedstockFractionFromReusedProduct
                                                               ontomatpassport:ProductFractionCollectedForRecycling
                                                               ontomatpassport:ProductFractionCollectedForReuse
                                                               ontomatpassport:RecyclingEfficiencyForPortionCollectedForRecycling
                                                               ontomatpassport:RecyclingEfficiencyForProducingFeedstock
                                                             )
                                               ] ;
                                   rdfs:range xsd:float ;
                                   rdfs:comment "The numerical value of a measured/assessed quantity expressed in percentage." ;
