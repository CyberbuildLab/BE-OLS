xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/bcore/zones#BuiltUpArea
:BuiltUpArea rdf:type owl:Class ;
             rdfs:subClassOf <https://w3id.org/bot#Zone> ;
             rdfs:comment "Ortschaft/ Fläche, die mit Gebäuden oder Bauwerken bebaut ist oder wird"@de ,
                          "town/ area that is covered with buildings or anthropogene structures"@en ;
             rdfs:label "bebautes Gebiet"@de ,
                        "built-up area"@en .


###  https://w3id.org/bcore/zones#Estate
:Estate rdf:type owl:Class ;
        rdfs:subClassOf <https://w3id.org/bot#Zone> ;
        rdfs:comment "Grundstück (Grundbesitz)"@de ,
                     "estate (land ownership, real estate)"@en ;
        rdfs:label "Grundstück"@de ,
                   "estate"@en .


###  https://w3id.org/bcore/zones#Field
:Field rdf:type owl:Class ;
       rdfs:subClassOf :VegetationArea ;
       rdfs:comment "Feld (z. B. Landwirtschaft)"@de ,
                    "field (e.g., agriculture)"@en ;
       rdfs:label "Feld"@de ,
                  "field"@en .


###  https://w3id.org/bcore/zones#Forest
:Forest rdf:type owl:Class ;
        rdfs:subClassOf :VegetationArea ;
        rdfs:comment "bewaldetes Gebiet"@de ,
                     "forrest/wood"@en ;
        rdfs:label "Wald"@de ,
                   "forest"@en .


###  https://w3id.org/bcore/zones#LandscapeConservationMeasureArea
:LandscapeConservationMeasureArea rdf:type owl:Class ;
                                  rdfs:subClassOf <https://w3id.org/bot#Zone> ;
                                  rdfs:comment "Fläche, die einem Landschafts- oder Naturschutz unterliegt"@de ,
                                               "area that is protected by landscape or nature protection"@en ;
                                  rdfs:label "Landschaftsschutzgebiet"@de ,
                                             "landscape conservation measure area"@en .


###  https://w3id.org/bcore/zones#Meadow
:Meadow rdf:type owl:Class ;
        rdfs:subClassOf :VegetationArea ;
        rdfs:comment "Wiese/Aue"@de ,
                     "meadow/ lawn"@en ;
        rdfs:label "Wiese"@de ,
                   "meadow"@en .


###  https://w3id.org/bcore/zones#VegetationArea
:VegetationArea rdf:type owl:Class ;
                rdfs:subClassOf <https://w3id.org/bot#Zone> ;
                rdfs:comment "bewachsene Fläche"@de ,
                             "planted area"@en ;
                rdfs:label "Vegetationsgebiet"@de ,
                           "vegetation area"@en .


###  https://w3id.org/bcore/zones#WaterBody
:WaterBody rdf:type owl:Class ;
           rdfs:subClassOf <https://w3id.org/bot#Zone> ;
           rdfs:comment "Fläche, die permanent mit Wasser bedeckt ist"@de ,
                        "area that is permanently covered by water"@en ;
           rdfs:label "Gewässer"@de ,
                      "water body"@en .


###  https://w3id.org/bot#Zone
<https://w3id.org/bot#Zone> rdf:type owl:Class .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :BuiltUpArea
                :Estate
                :LandscapeConservationMeasureArea
                :VegetationArea
                :WaterBody
              )
] .


