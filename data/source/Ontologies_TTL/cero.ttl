                         <http://purl.org/vocab/vann/preferredNamespacePrefix> "cero" ;
                         <http://purl.org/vocab/vann/preferredNamespaceUri> : ;
                         rdfs:comment """
CERO describes reusable cast-in-place reinforced concrete elements to support a circular economy in construction.
""" ;
