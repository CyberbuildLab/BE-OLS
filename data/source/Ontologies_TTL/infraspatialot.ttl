###  http://purl.org/dc/terms/DCMIType
<http://purl.org/dc/terms/DCMIType> rdf:type owl:NamedIndividual ,
                                             <http://purl.org/dc/dcam/VocabularyEncodingScheme> ;
                                    <http://purl.org/dc/terms/issued> "2000-07-11"^^xsd:date ;
