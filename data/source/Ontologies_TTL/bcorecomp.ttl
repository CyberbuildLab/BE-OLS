                       "pier unit/group"@en ;
          rdfs:label "pier unit"@en .


###  https://w3id.org/bcore/comp#PlateGirder
:PlateGirder rdf:type owl:Class ;
             rdfs:subClassOf <https://w3id.org/brcomp#GirderMainGirder> ;
             rdfs:comment "Vollwandträger (z. B. aus Stahl)"@de ,
                          "plate girder (solid-web; e.g., made of steel)"@en ;
             rdfs:label "plate girder"@en .


###  https://w3id.org/bcore/comp#Rope
:Rope rdf:type owl:Class ;
      rdfs:subClassOf <https://w3id.org/brcomp#TensionComponent> ;
