<https://dtc-ontology.cms.ed.tum.de/infraspatialot#Localisation> rdf:type owl:Class .


###  https://w3id.org/bcore/comp#Abutment
:Abutment rdf:type owl:Class ;
          rdfs:subClassOf <https://w3id.org/brcomp#SubStructureComponent> ;
          rdfs:comment "Widerlager"@de ,
                       "bridge abutment"@en ;
          rdfs:label "abutment"@en .


###  https://w3id.org/bcore/comp#BoxGirder
:BoxGirder rdf:type owl:Class ;
           rdfs:subClassOf <https://w3id.org/brcomp#GirderMainGirder> ;
           rdfs:comment "Hohlkastenträger"@de ,
                        "box girder/ hollow beam"@en ;
           rdfs:label "box girder"@en .


###  https://w3id.org/bcore/comp#EquipmentComponent
:EquipmentComponent rdf:type owl:Class ;
                    rdfs:subClassOf <https://w3id.org/brot#Component> ;
                    owl:disjointWith <https://w3id.org/brcomp#SubStructureComponent> ,
                                     <https://w3id.org/brcomp#SuperStructureComponent> ;
                    rdfs:comment "Bauteil der Brückenausstattung"@de ,
                                 "component of bridge equipment"@en ;
                    rdfs:label "equipment component"@en ;
                    rdfs:seeAlso "https://w3id.org/brcomp/#FinishingComponent" .


###  https://w3id.org/bcore/comp#IBeam
:IBeam rdf:type owl:Class ;
       rdfs:subClassOf <https://w3id.org/brcomp#GirderMainGirder> ;
