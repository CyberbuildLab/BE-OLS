@prefix bcorecomp: <https://w3id.org/bcore/comp#> .
@prefix bcore: <https://w3id.org/bcore#> .
@prefix brot: <https://w3id.org/brot#> .
@prefix brcomp: <https://w3id.org/brcomp#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/bcore/comp#> .

<https://w3id.org/bcore/comp> rdf:type owl:Ontology ;
                               <http://purl.org/dc/elements/1.1/abstract> "The Bridge Core Ontology (BCore) enables the representation of a bridge structure, its components and material, as well as the infrastructure and media files connected to it and the environment and location of the bridge. BCore is created by the Institute of Concrete Structures (IMB) at the Dresden University of Technology (TUD). This ontology contains the corresponding components extension."@en ;
                               <http://purl.org/dc/elements/1.1/title> "Bridge Core Ontology for Institute of Concrete Structures, Dresden University of Technology – Components Extension"@en ;
                               <http://purl.org/dc/terms/contributor> "Jakob Vogt" ;
                               <http://purl.org/dc/terms/created> "2025-11-06"^^xsd:date ;
                               <http://purl.org/dc/terms/creator> "Johannes Reimer" ,
                                                                  "Morris Florek" ,
                                                                  "Tim Noack" ,
                                                                  "Xiaoli Song" ;
                               <http://purl.org/dc/terms/description> "Extension ontology for the representation of bridge components. Designed to work in conjunction with the BCore ontology but to also allow for external use."@en ;
                               <http://purl.org/dc/terms/license> "https://creativecommons.org/licenses/by/4.0/deed.en" ;
                               <http://purl.org/dc/terms/modified> "2026-07-21"^^xsd:date ;
                               <http://purl.org/ontology/bibo/status> "Ontology Specification Draft" ;
                               <http://purl.org/vocab/vann/preferredNamespacePrefix> "bcorecomp" ;
                               rdfs:label "Bridge Core Ontology – Components Extension"@en ;
                               owl:versionInfo "0.1.1" ;
                               <http://xmlns.com/foaf/0.1/logo> "https://raw.githubusercontent.com/TUD-IMB/BCore/main/BCore.svg" ;
                               <https://schema.org/codeRepository> "https://github.com/TUD-IMB/BCore" .

