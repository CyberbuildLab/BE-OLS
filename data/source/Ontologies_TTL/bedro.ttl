[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "DE: Der Abstand des Referenzpunkts der rechten Kappe von der Brückenachse berechnet sich aus CAP99XXq00=PAV00XXq00-CAP99XXb04-PAV00XXb01, wobei PAV der angrenzende Fahrbahnbelag ist.; EN: The distance between the reference point of the right cap and the bridge axis is calculated as follows CAP99XXq00=PAV00XXq00-CAP99XXb04-PAV00XXb01, where PAV represents the adjacent pavement." ;
   rdfs:label "CAP99XXq00" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> <https://w3id.org/brcomp#Cap> ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :c
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> <https://w3id.org/reloc#meetRight> ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :c ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> :p
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#classPredicate> <https://w3id.org/brcomp#Pavement> ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> :p
                                                                           ] ;
                                                                 rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                            rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                                                        <http://www.w3.org/2003/11/swrl#propertyPredicate> :XXXxxXXq00 ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument1> :p ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument2> :pq
                                                                                      ] ;
                                                                            rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                       rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                                                                   <http://www.w3.org/2003/11/swrl#propertyPredicate> :CAPxxXXb04 ;
                                                                                                   <http://www.w3.org/2003/11/swrl#argument1> :c ;
                                                                                                   <http://www.w3.org/2003/11/swrl#argument2> :cb04
                                                                                                 ] ;
                                                                                       rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                                  rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                                                                              <http://www.w3.org/2003/11/swrl#propertyPredicate> :PAV00XXb01 ;
                                                                                                              <http://www.w3.org/2003/11/swrl#argument1> :p ;
                                                                                                              <http://www.w3.org/2003/11/swrl#argument2> :pb01
                                                                                                            ] ;
                                                                                                  rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                                             rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#BuiltinAtom> ;
                                                                                                                         <http://www.w3.org/2003/11/swrl#builtin> <http://www.w3.org/2003/11/swrlb#add> ;
